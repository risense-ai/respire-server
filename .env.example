# Copy to .env and supply your own credentials. Never commit real secrets.
# Match the image tag to service/Cargo.toml and a validated published image.
RSRS_SERVER_IMAGE=ghcr.io/risense-ai/respire-server:1.0.0

# Required. Generate a random password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
RSRS_DATABASE_USER=respire
RSRS_DATABASE_NAME=respire
# Optional explicit connection URL for an existing API/database installation.
DATABASE_URL=

# Bind the API to loopback behind a TLS reverse proxy by default.
# A public plain HTTP binding exposes tokens and password hashes in transit.
RSRS_HOST_BIND=127.0.0.1
RSRS_HOST_PORT=8787

# Optional legacy administrator token. Empty disables only this token;
# database-backed administrators and their role checks remain enabled.
# Generate locally with: openssl rand -hex 32
RSRS_ADMIN_TOKEN=

# Optional authenticated SMTP. Use your MXroute control panel's Email Clients settings.
# Enable only after supplying all four required values. 587 requires STARTTLS; 465 uses TLS.
RSRS_SMTP_HOST=
RSRS_SMTP_PORT=587
RSRS_SMTP_USERNAME=
RSRS_SMTP_PASSWORD=
RSRS_MAIL_FROM=

# Exact comma-separated trusted browser origins; empty disables cross-origin access.
# Configure before deploying the Pages frontends. Never use wildcards or null.
# Production: https://dash.rsrs.rs,https://admin.rsrs.rs
# DEV Pages: https://dash.dev.rsrs.rs,https://admin.dev.rsrs.rs
# Local development: http://localhost:5173 (use isolated API/database, not production)
RSRS_CORS_ALLOWED_ORIGINS=

# Browser verification origin for CLI/TUI OAuth; match the selected API environment.
# Required DEV override: RSRS_DASHBOARD_URL=https://dash.dev.rsrs.rs
# Production uses https://dash.rsrs.rs. Do not leave that origin in a DEV .env.
RSRS_DASHBOARD_URL=https://dash.rsrs.rs

# Separate OAuth apps for DEV and production. Secrets belong only on the API server.
# Callback must be the exact HTTPS dashboard root (including trailing slash).
RSRS_GITHUB_CLIENT_ID=
RSRS_GITHUB_CLIENT_SECRET=
RSRS_GITHUB_REDIRECT_URI=
